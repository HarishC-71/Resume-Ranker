PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/resume-ranker
# Or MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.fuobsgg.mongodb.net/mydatabase?retryWrites=true&w=majority

# Cloudinary (required for persistent file storage on Render / production)
# Sign up free at https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
